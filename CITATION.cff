    given-names: Anton
    affiliation: "Tyche Institute"
    orcid: "https://orcid.org/0000-0003-2452-7096"
    email: anton.sokolov@tyche.institute
keywords:
  - eIDAS
  - trusted list
  - trust services
  - digital identity
  - observatory
  - open data
